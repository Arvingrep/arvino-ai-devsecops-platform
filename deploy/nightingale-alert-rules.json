[
  {
    "name": "Arvino API down",
    "note": "The arvino orchestrator API is unreachable or responding with errors.",
    "severity": 1,
    "disabled": 0,
    "prom_for_duration": 120,
    "prom_ql": "up{job=~\"arvino-orchestrator\"} == 0 or arvino_database_up == 0",
    "prom_eval_interval": 30,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": [],
    "notify_channels": [],
    "notify_groups": [],
    "notify_recovered": 1,
    "append_tags": ["component=arvino-api", "layer=platform"],
    "callbacks": [
      {
        "type": "webhook",
        "url": "http://arvino-orchestrator/webhooks/nightingale",
        "headers": {"x-arvino-token": "${ARVINO_NIGHTINGALE_WEBHOOK_TOKEN}"},
        "timeout": 10
      }
    ]
  },
  {
    "name": "Arvino worker crash",
    "note": "The arvino worker deployment has zero ready replicas. No worker means no agent steps can execute.",
    "severity": 1,
    "disabled": 0,
    "prom_for_duration": 120,
    "prom_ql": "kube_deployment_status_replicas_ready{deployment=\"arvino-orchestrator\", namespace=~\"arvino.*\"} == 0",
    "prom_eval_interval": 30,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": [],
    "notify_channels": [],
    "notify_groups": [],
    "notify_recovered": 1,
    "append_tags": ["component=arvino-worker", "layer=platform"],
    "callbacks": [
      {
        "type": "webhook",
        "url": "http://arvino-orchestrator/webhooks/nightingale",
        "headers": {"x-arvino-token": "${ARVINO_NIGHTINGALE_WEBHOOK_TOKEN}"},
        "timeout": 10
      }
    ]
  },
  {
    "name": "Arvino run stuck >1h",
    "note": "A run has been active (running) for more than 1 hour without reaching a terminal state. This may indicate a stuck agent step, a missed completion callback, or an approval that is awaiting a decision with no timeout.",
    "severity": 2,
    "disabled": 0,
    "prom_for_duration": 300,
    "prom_ql": "arvino_runs_total{status=\"running\"} > 0 and (time() - arvino_runs_started_at_seconds{status=\"running\"}) > 3600",
    "prom_eval_interval": 60,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": [],
    "notify_channels": [],
    "notify_groups": [],
    "notify_recovered": 1,
    "append_tags": ["component=arvino-engine", "layer=platform"],
    "callbacks": [
      {
        "type": "webhook",
        "url": "http://arvino-orchestrator/webhooks/nightingale",
        "headers": {"x-arvino-token": "${ARVINO_NIGHTINGALE_WEBHOOK_TOKEN}"},
        "timeout": 10
      }
    ]
  },
  {
    "name": "Arvino high error rate",
    "note": "Step or run failure rate is elevated significantly above baseline.",
    "severity": 2,
    "disabled": 0,
    "prom_for_duration": 300,
    "prom_ql": "rate(arvino_http_requests_total{status=~\"5..\"}[10m]) / rate(arvino_http_requests_total[10m]) > 0.1",
    "prom_eval_interval": 60,
    "enable_stime": "00:00",
    "enable_etime": "23:59",
    "enable_days_of_week": [],
    "notify_channels": [],
    "notify_groups": [],
    "notify_recovered": 1,
    "append_tags": ["component=arvino-api", "layer=platform", "kind=error-rate"],
    "callbacks": [
      {
        "type": "webhook",
        "url": "http://arvino-orchestrator/webhooks/nightingale",
        "headers": {"x-arvino-token": "${ARVINO_NIGHTINGALE_WEBHOOK_TOKEN}"},
        "timeout": 10
      }
    ]
  }
]